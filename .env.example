ENVIRONMENT=local
PORT=3006
DATABASE_NAME=adinkra-db
DATABASE_HOST=localhost
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
TEST_DATABASE_NAME=test-adinkra-db
