{
  "name": "adinkra-api",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf ./build && tsc -p tsconfig.prod.json",
    "dev": "nodemon src/server.ts",
    "start": "node build/src/server.js",
    "typeorm": "typeorm-ts-node-esm",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "seed:location-types": "ts-node src/seeding/location-types-seed.ts",
    "seed:vehicle-types": "ts-node src/seeding/vehicle-types-seed.ts",
    "seed:permissions": "ts-node src/seeding/permissions-seed.ts",
    "seed:user-roles": "ts-node src/seeding/user-roles-seed.ts",
    "seed:admin": "ts-node src/seeding/admin-seed.ts",
    "seed:countries": "ts-node src/seeding/countries-seed.ts",
    "seed:states": "ts-node src/seeding/states-seed.ts",
    "seed:cities": "ts-node src/seeding/cities-seed.ts",
    "seed:demo": "ts-node src/seeding/demo-seed.ts",
    "test": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "country-state-city": "^3.2.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-async-handler": "^1.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.31",
    "typeorm-extension": "^3.9.0",
    "ulid": "^2.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
